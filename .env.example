# Copie para .env.local e preencha com os valores reais.
# NUNCA commite valores reais neste arquivo — ele é versionado.

# Supabase (produtos, auth de magic link, storage de imagens)
# Painel: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook Cakto (Lifetime Deal + Order Bump)
# Configurar em https://app.cakto.com.br/settings/webhooks
# URL de produção: https://eitapromo.gf.dev.br/api/webhooks/cakto
CAKTO_WEBHOOK_SECRET=

# Shopee Affiliate Open API (productOfferV2)
# Painel: https://affiliate.shopee.com.br/open_api
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=
