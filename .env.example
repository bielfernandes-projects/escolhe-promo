# Copie para .env.local e preencha com os valores reais.
# NUNCA commite valores reais neste arquivo — ele é versionado.

# Supabase (produtos, auth de magic link, storage de imagens)
# Painel: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook Cakto (Lifetime Deal + Order Bump)
# Configurar em https://app.cakto.com.br/settings/webhooks
# URL de produção: https://www.escolhepromo.com.br/api/webhooks/cakto
CAKTO_WEBHOOK_SECRET=

# SMTP (Resend) para e-mails de acesso e recuperação de senha
# Configurar em Supabase → Authentication → Emails → SMTP Settings
# Credenciais não usam env var — vivem no painel do Supabase

# Shopee Affiliate Open API (productOfferV2)
# Painel: https://affiliate.shopee.com.br/open_api
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=

# Protege /api/cron/sync-produtos
CRON_SECRET=

# URL do checkout hospedado da Cakto
NEXT_PUBLIC_CAKTO_CHECKOUT_URL=

# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Pixel do Meta Ads (client, PageView/retargeting)
NEXT_PUBLIC_META_PIXEL_ID=

# Token gerado em Gerenciador de Eventos > Configuracoes > Conversions API
META_CONVERSIONS_API_TOKEN=

# Mesmo Pixel ID, usado server-side na Conversions API
META_PIXEL_ID=

# OpenRouter — escreve as legendas de Instagram (server-side).
# Uma legenda por produto, cacheada no banco; ver src/lib/copy/legenda.ts.
OPENROUTER_API_KEY=
